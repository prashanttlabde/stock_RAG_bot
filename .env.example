# template = deterministic extractive answers, works offline with no API key
# llm      = call the Groq model below with a grounded prompt, falls back to
#            template on any error (missing key, timeout, bad response, etc.)
GENERATION_MODE=template

# Groq (https://console.groq.com/keys) is the only LLM provider this project's
# _build_client() actually wires up. Paste your key below and switch
# GENERATION_MODE to llm above to use it; leave it blank to stay offline.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Generic fallbacks _build_client() also checks if the Groq-specific ones above
# are blank. Not needed if you filled in GROQ_API_KEY.
LLM_API_KEY=
LLM_MODEL=

LOG_LEVEL=INFO

# optional: append retrieved scheme/section/score lines to each reply (demo debug view)
SHOW_RETRIEVAL=false
